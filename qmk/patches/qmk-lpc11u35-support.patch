diff --git a/platforms/chibios/drivers/eeprom/eeprom_lpc11uxx.c b/platforms/chibios/drivers/eeprom/eeprom_lpc11uxx.c
new file mode 100644
index 00000000..9e5493d4
--- /dev/null
+++ b/platforms/chibios/drivers/eeprom/eeprom_lpc11uxx.c
@@ -0,0 +1,150 @@
+// Copyright 2026 Michael Loukeris (@milouk)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// On-chip EEPROM of the LPC11U2x/3x, through the ROM's IAP calls.
+// Only the EEPROM commands are issued here, so this cannot alter flash.
+
+#include <string.h>
+#include "ch.h"
+#include "hal.h"
+#include "eeprom_driver.h"
+#include "eeprom_lpc11uxx.h"
+
+#define IAP_ENTRY 0x1FFF1FF1U
+#define IAP_CMD_EEPROM_WRITE 61U
+#define IAP_CMD_EEPROM_READ 62U
+#define IAP_CMD_SUCCESS 0U
+
+#define EEPROM_PAGE_SIZE 64U
+
+// Interrupts are off for the whole of each IAP call (UM10462 20.8.7), about 3 ms for
+// a write. QMK writes its defaults a byte at a time, and several hundred such calls in
+// a row keep USB from enumerating. Sequential writes are therefore collected and sent
+// a page at a time, at the latest FLUSH_DELAY after the last one. Reads see the
+// collected bytes, so read-before-write updates do not force a write per byte.
+#define FLUSH_DELAY TIME_MS2I(10)
+
+typedef void (*iap_entry_t)(uint32_t[], uint32_t[]);
+
+static uint8_t         pending[EEPROM_PAGE_SIZE];
+static uint32_t        pending_addr;
+static uint8_t         pending_len;
+static virtual_timer_t flush_timer;
+
+// Call with the system locked.
+static bool iap_eeprom(uint32_t command_code, uint32_t ee_addr, uint8_t *ram, uint32_t len) {
+    uint32_t command[5] = {command_code, ee_addr, (uint32_t)ram, len, CPU_CLOCK / 1000U};
+    uint32_t result[4]  = {~IAP_CMD_SUCCESS, 0, 0, 0};
+
+    ((iap_entry_t)IAP_ENTRY)(command, result);
+
+    return result[0] == IAP_CMD_SUCCESS;
+}
+
+// Call with the system locked.
+static void flush_pending(void) {
+    if (pending_len > 0) {
+        iap_eeprom(IAP_CMD_EEPROM_WRITE, pending_addr, pending, pending_len);
+        pending_len = 0;
+    }
+}
+
+static void flush_timer_cb(virtual_timer_t *vtp, void *arg) {
+    (void)vtp;
+    (void)arg;
+
+    chSysLockFromISR();
+    flush_pending();
+    chSysUnlockFromISR();
+}
+
+static size_t clamp_length(uintptr_t offset, size_t len) {
+    if (offset >= LPC11UXX_EEPROM_SIZE) {
+        return 0;
+    }
+    if (len > LPC11UXX_EEPROM_SIZE - offset) {
+        len = LPC11UXX_EEPROM_SIZE - offset;
+    }
+    return len;
+}
+
+void eeprom_driver_init(void) {
+    chVTObjectInit(&flush_timer);
+}
+
+void eeprom_driver_erase(void) {
+    uint8_t blank[EEPROM_PAGE_SIZE];
+    memset(blank, 0xFF, sizeof(blank));
+
+    for (uint32_t addr = 0; addr < LPC11UXX_EEPROM_SIZE; addr += EEPROM_PAGE_SIZE) {
+        uint32_t len = LPC11UXX_EEPROM_SIZE - addr < EEPROM_PAGE_SIZE ? LPC11UXX_EEPROM_SIZE - addr : EEPROM_PAGE_SIZE;
+
+        syssts_t sts = chSysGetStatusAndLockX();
+        if (addr == 0) {
+            pending_len = 0;
+        }
+        iap_eeprom(IAP_CMD_EEPROM_WRITE, addr, blank, len);
+        chSysRestoreStatusX(sts);
+    }
+}
+
+void eeprom_read_block(void *buf, const void *addr, size_t len) {
+    uintptr_t offset = (uintptr_t)addr;
+    size_t    usable = clamp_length(offset, len);
+
+    // Bytes outside the EEPROM, or a failed read, come back as erased.
+    memset(buf, 0xFF, len);
+    if (usable > 0) {
+        syssts_t sts = chSysGetStatusAndLockX();
+        bool     ok  = iap_eeprom(IAP_CMD_EEPROM_READ, offset, buf, usable);
+
+        // Bytes still waiting to be written take precedence over what is stored.
+        uint32_t start = offset > pending_addr ? offset : pending_addr;
+        uint32_t end   = offset + usable < pending_addr + pending_len ? offset + usable : pending_addr + pending_len;
+        if (ok && start < end) {
+            memcpy((uint8_t *)buf + (start - offset), &pending[start - pending_addr], end - start);
+        }
+        chSysRestoreStatusX(sts);
+
+        if (!ok) {
+            memset(buf, 0xFF, len);
+        }
+    }
+}
+
+void eeprom_write_block(const void *buf, void *addr, size_t len) {
+    uintptr_t      offset = (uintptr_t)addr;
+    const uint8_t *src    = buf;
+
+    len = clamp_length(offset, len);
+    if (len == 0) {
+        return;
+    }
+
+    while (len > 0) {
+        syssts_t sts = chSysGetStatusAndLockX();
+
+        // Start a new run when this byte does not follow the pending ones, or opens a new page.
+        if (pending_len > 0 && (offset != pending_addr + pending_len || offset % EEPROM_PAGE_SIZE == 0)) {
+            flush_pending();
+        }
+        if (pending_len == 0) {
+            pending_addr = offset;
+        }
+
+        size_t chunk = EEPROM_PAGE_SIZE - (offset % EEPROM_PAGE_SIZE);
+        if (chunk > len) {
+            chunk = len;
+        }
+        memcpy(&pending[pending_len], src, chunk);
+        pending_len += chunk;
+
+        chSysRestoreStatusX(sts);
+
+        offset += chunk;
+        src += chunk;
+        len -= chunk;
+    }
+
+    chVTSet(&flush_timer, FLUSH_DELAY, flush_timer_cb, NULL);
+}
diff --git a/platforms/chibios/drivers/eeprom/eeprom_lpc11uxx.h b/platforms/chibios/drivers/eeprom/eeprom_lpc11uxx.h
new file mode 100644
index 00000000..be130249
--- /dev/null
+++ b/platforms/chibios/drivers/eeprom/eeprom_lpc11uxx.h
@@ -0,0 +1,16 @@
+// Copyright 2026 Michael Loukeris (@milouk)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+/*
+    The size of the EEPROM area handed to QMK, in bytes.
+    The LPC11U35 has 4 kB of EEPROM, of which the top 64 bytes are reserved by the ROM.
+*/
+#ifndef LPC11UXX_EEPROM_SIZE
+#    define LPC11UXX_EEPROM_SIZE 1024
+#endif
+
+#if LPC11UXX_EEPROM_SIZE > (4096 - 64)
+#    error LPC11UXX_EEPROM_SIZE is larger than the usable on-chip EEPROM
+#endif
diff --git a/platforms/chibios/mcu_selection.mk b/platforms/chibios/mcu_selection.mk
index 199bdb23..3f59fe90 100644
--- a/platforms/chibios/mcu_selection.mk
+++ b/platforms/chibios/mcu_selection.mk
@@ -776,6 +776,37 @@ ifneq (,$(filter $(MCU),STM32H723 STM32H733))
   STM32_BOOTLOADER_ADDRESS ?= 0x1FF09800
 endif
 
+ifneq ($(findstring LPC11U35, $(MCU)),)
+  # Cortex version
+  MCU = cortex-m0
+
+  # ARM version, CORTEX-M0/M1 are 6, CORTEX-M3/M4/M7 are 7
+  ARMV = 6
+
+  ## chip/board settings
+  # - the next two should match the directories in
+  #   <chibios[-contrib]>/os/hal/ports/$(MCU_PORT_NAME)/$(MCU_SERIES)
+  #   OR
+  #   <chibios[-contrib]>/os/hal/ports/$(MCU_FAMILY)/$(MCU_SERIES)
+  MCU_FAMILY = LPC
+  MCU_SERIES = LPC11Uxx
+
+  # Linker script to use
+  # - it should exist either in <chibios>/os/common/ports/ARMCMx/compilers/GCC/ld/
+  #   or <keyboard_dir>/ld/
+  MCU_LDSCRIPT ?= LPC11U35_401
+
+  # Startup code to use
+  #  - it should exist in <chibios>/os/common/startup/ARMCMx/compilers/GCC/mk/
+  MCU_STARTUP ?= lpc11uxx
+
+  # Board: it should exist either in <chibios>/os/hal/boards/,
+  # <keyboard_dir>/boards/, or drivers/boards/
+  BOARD ?= GENERIC_LPC_11U35
+
+  USE_FPU ?= no
+endif
+
 ifneq ($(findstring WB32F3G71, $(MCU)),)
   # Cortex version
   MCU = cortex-m3
diff --git a/platforms/eeprom.h b/platforms/eeprom.h
index 557bfb03..201ec1af 100644
--- a/platforms/eeprom.h
+++ b/platforms/eeprom.h
@@ -51,6 +51,9 @@ void     eeprom_update_block(const void *__src, void *__dst, size_t __n);
 #elif defined(EEPROM_STM32_L0_L1)
 #    include "eeprom_stm32_L0_L1.h"
 #    define TOTAL_EEPROM_BYTE_COUNT (STM32_ONBOARD_EEPROM_SIZE)
+#elif defined(EEPROM_LPC11UXX)
+#    include "eeprom_lpc11uxx.h"
+#    define TOTAL_EEPROM_BYTE_COUNT (LPC11UXX_EEPROM_SIZE)
 #elif defined(EEPROM_KINETIS_FLEXRAM)
 #    include "eeprom_kinetis_flexram.h"
 #    define TOTAL_EEPROM_BYTE_COUNT (EEPROM_SIZE)

From 1f278faf5aae0bcf305510e36142c5f64de771a9 Mon Sep 17 00:00:00 2001
From: Michael Loukeris <loukerismichalis@gmail.com>
Date: Wed, 14 Oct 2026 09:18:07 +0300
Subject: [PATCH 2/3] Keep the IAP RAM free and add an EEPROM flush for
 LPC11U35

---
 .../chibios/boards/common/ld/LPC11U35_401.ld  | 104 ++++++++++++++++++
 .../chibios/drivers/eeprom/eeprom_lpc11uxx.c  |  12 +-
 .../chibios/drivers/eeprom/eeprom_lpc11uxx.h  |   3 +
 3 files changed, 118 insertions(+), 1 deletion(-)
 create mode 100644 platforms/chibios/boards/common/ld/LPC11U35_401.ld

diff --git a/platforms/chibios/boards/common/ld/LPC11U35_401.ld b/platforms/chibios/boards/common/ld/LPC11U35_401.ld
new file mode 100644
index 00000000..3959c156
--- /dev/null
+++ b/platforms/chibios/boards/common/ld/LPC11U35_401.ld
@@ -0,0 +1,104 @@
+/*
+ * Copyright (C) 2020 Yaotian Feng / Codetector
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining
+ * a copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
